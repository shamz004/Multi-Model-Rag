# ---- Required ---------------------------------------------------------
# Your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# ---- Models (optional - defaults shown) --------------------------------
# Model that writes the answers
OPENAI_CHAT_MODEL=gpt-4o-mini
# Model that rewrites follow-up questions (leave empty to reuse the chat model)
OPENAI_REWRITE_MODEL=
# Model that turns text into vectors. Changing this later requires deleting
# the data folder and re-uploading the documents.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Retrieval tuning (optional - defaults shown) ----------------------
# Chunk size and overlap, in characters
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
# Passages sent to the model per question
TOP_K=6
# Candidates taken from each search method before fusion
CANDIDATE_K=20
# If the best match is below this cosine similarity, the system answers
# "not found in the documents" without calling the model
MIN_SIMILARITY=0.22
# Previous messages kept as conversation memory
HISTORY_MESSAGES=8

# ---- Limits (optional) -------------------------------------------------
MAX_UPLOAD_MB=50
